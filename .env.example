# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=klinik
POSTGRES_PASSWORD=degistir-beni
DATABASE_URL=postgresql://klinik:degistir-beni@localhost:5434/klinik_crm

# ── Hermes ajanı ────────────────────────────────────────────
# Ajan bu klasöre özel. Global ~/.hermes HİÇ kullanılmaz.
HERMES_HOME=./hermes-home

# Test ortamı: ZAI / GLM. VPS'e geçince bu iki satırı
#   AJAN_PROVIDER=openai
#   AJAN_MODEL=gpt-5.6-luna
# yap ve OPENAI_API_KEY'i doldur. Boş bırakılırsa hermes-home/config.yaml
# içindeki model (gpt-5.6-luna) geçerli olur.
AJAN_PROVIDER=zai
AJAN_MODEL=glm-4.6

ZAI_API_KEY=
OPENAI_API_KEY=

# Sağlayıcının uç noktası. Boşsa koddaki varsayılan kullanılır (zai için
# coding planı, openai için api.openai.com). ZAI'de abonelik türü hangi uç
# noktanın çalıştığını belirliyor — 429 "Insufficient balance" alırsan
# diğerini dene: https://api.z.ai/api/paas/v4
AJAN_TABAN_URL=

# ── Hafif yol (Hermes'siz cevap) ────────────────────────────
# Bilgi soruları Hermes'e uğramadan cevaplanır: aynı SOUL.md, aynı bilgi
# tabanı, doğrudan API çağrısı. Ölçüldü: 6.915 → 2.210 token (%68 az).
# Randevu isteği bu yola girmez, Hermes'te kalır — araçlar orada.
# Sorun çıkarsa 0 yap; her mesaj Hermes'e döner, davranış eskisi gibi olur.
HAFIF_YOL=1

# Hafif yol için ayrı (ucuz) model. Boşsa AJAN_MODEL kullanılır.
AJAN_HAFIF_MODEL=

# 1M token fiyatı — doldurulursa hafif yolun maliyeti panelde görünür.
# Boş bırakılırsa maliyet yazılmaz; uydurulmuş rakam gerçek gibi görünürdü.
AJAN_1M_GIRIS_USD=
AJAN_1M_CIKIS_USD=

# ── OpenWA (WhatsApp) ───────────────────────────────────────
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION=klinik
# Webhook kaydında verdiğin secret ile birebir aynı olmalı
WEBHOOK_SECRET=

# ── Panel ───────────────────────────────────────────────────
# Kenar çubuğunda ve sayfa başlıklarında görünen klinik adı
KLINIK_ADI=Klinik Paneli
PANEL_PAROLA=degistir-beni
COOKIE_SECRET=openssl-rand-hex-32-ile-uret
# Ajanın CRM'e yazarken kullandığı iç anahtar
IC_API_ANAHTARI=openssl-rand-hex-32-ile-uret

# ── Klinik konumu ───────────────────────────────────────────
# Adres sorulduğunda ajan harita iğnesi gönderir. "enlem,boylam" — Google
# Haritalar'da klinik pinine sağ tıklayınca çıkan iki sayı.
# Boş bırakılırsa iğne gitmez, ajan adresi yalnız yazıyla verir.
KLINIK_KONUM=

# ── Çalışma saatleri ────────────────────────────────────────
# 1=Pazartesi ... 7=Pazar
CALISMA_GUNLERI=1,2,3,4,5,6
CALISMA_SAATLERI=09:00-18:00

# ── Composio (Google Takvim + Gmail) ────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_MCP_URL=

# ── Instagram (YALNIZ BİLGİLENDİRME) ────────────────────────
# Bu kanal randevu açmaz ve hatırlatma göndermez — nedeni app/instagram.py'de.
# Açmak için: Composio'da Instagram'ı bağla (Business/Creator hesap şart),
# aşağıdaki iki satırı doldur, servisi yeniden başlat.
# Araç adlarını doğrula:  .venv/bin/python -m app.instagram --kesfet
INSTAGRAM_KULLANICI=          # Composio'daki connected account user_id
INSTAGRAM_HESAP_ID=           # kliniğin kendi IGSID'si — kendi mesajlarını ayırt etmek için
INSTAGRAM_ARALIK_SN=30
INSTAGRAM_TUR_TAVANI=5        # bir turda en çok kaç cevap (her biri bir LLM çağrısı)
INSTAGRAM_GERIYE_SAAT=6
INSTAGRAM_NOBETCISI=1

# Instagram'da randevu isteyene verilecek WhatsApp hattı
KLINIK_WHATSAPP_NUMARASI=

# ── Uyarı maili ─────────────────────────────────────────────
YONETICI_EPOSTA=
SMTP_HOST=
SMTP_PORT=587
SMTP_KULLANICI=
SMTP_PAROLA=

# OpenWA API anahtarlarının hash pepper değeri
OPENWA_API_KEY_PEPPER=

# Klinik saat dilimi
TZ=Europe/Istanbul

# ── Giden mesaj sınırları (ban koruması) ────────────────────
# Klinik yalnız randevu hatırlatması gönderir. Bu tavanlar WhatsApp'ın
# numarayı kapatmasını önler — gevşetmeden önce KUSURLAR.md'yi okuyun.
GIDEN_SAATLIK_TAVAN=20
GIDEN_GUNLUK_TAVAN=100
GIDEN_ARALIK_SN=8
SESSIZ_SAAT_BAS=21:00
SESSIZ_SAAT_BIT=09:00
HATIRLATMA_ARALIK_SN=300
